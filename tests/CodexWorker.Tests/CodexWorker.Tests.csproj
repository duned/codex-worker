<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CodexWorker/CodexWorker.csproj" />
    <ProjectReference Include="../../src/CodexServer/CodexServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../dashboard/server-dashboard-source.cjs" Link="tests/dashboard/server-dashboard-source.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/CodexServer/dashboard-*.js" Link="src/CodexServer/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../dashboard/server-stream-harness.cjs" Link="tests/dashboard/server-stream-harness.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../dashboard/server-stream-rendering.cjs" Link="tests/dashboard/server-stream-rendering.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/CodexServer/dashboard.html" Link="src/CodexServer/dashboard.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
