[Unit]
Description=Codex Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=codex-worker
Group=codex-worker
Environment=HOME=/var/lib/codex-worker
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=TMPDIR=/run/codex-worker
EnvironmentFile=/etc/codex-worker/worker.env
WorkingDirectory=/var/lib/codex-worker
RuntimeDirectory=codex-worker
RuntimeDirectoryMode=0750
ExecStart=/opt/codex-worker/CodexWorker /etc/codex-worker/worker.yml
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=5
KillSignal=SIGTERM
# Let the Worker interrupt and reap children; systemd kills the entire group if stop times out.
KillMode=mixed
TimeoutStopSec=300
UMask=0077

[Install]
WantedBy=multi-user.target
