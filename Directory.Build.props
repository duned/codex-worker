<Project>
  <PropertyGroup>
    <!-- Treat compiler and analyzer diagnostics as errors without promoting NuGet restore warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Current product version changes only through explicit release preparation, not roadmap/Issue numbering.
         Command-line Version overrides remain authoritative for releases. -->
    <Version>0.25.1</Version>
  </PropertyGroup>
</Project>
