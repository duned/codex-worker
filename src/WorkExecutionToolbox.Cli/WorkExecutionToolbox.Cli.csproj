<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wet</ToolCommandName>
    <PackageId>WorkExecutionToolbox.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Standalone GitHub Issue relationship planning toolbox.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../docs/work-execution-toolbox.md" Pack="true" PackagePath="README.md" />
    <ProjectReference Include="../WorkExecutionToolbox/WorkExecutionToolbox.csproj" />
  </ItemGroup>
</Project>
