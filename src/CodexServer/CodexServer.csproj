<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Frontend source/dependencies are build inputs, never deployment content. -->
    <Content Remove="worker-poc/**/*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Shared/CodexProvisioning.csproj" />
  </ItemGroup>
  <Target Name="RestoreWorkerPoc" BeforeTargets="PrepareForBuild"
          Inputs="worker-poc/package.json;worker-poc/package-lock.json"
          Outputs="worker-poc/node_modules/.package-lock.json">
    <Exec WorkingDirectory="worker-poc" Command="npm ci --no-audit --no-fund" />
  </Target>
  <!-- Always regenerate: timestamp-only inputs miss deleted source and stale copied bundles. -->
  <Target Name="BuildWorkerPoc" BeforeTargets="PrepareForBuild" DependsOnTargets="RestoreWorkerPoc">
    <Exec WorkingDirectory="worker-poc" Command="npm run typecheck &amp;&amp; npm run lint &amp;&amp; node build.mjs &quot;$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'worker-poc'))&quot;" />
  </Target>
  <Target Name="EmbedDashboardPreview" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWorkerPoc">
    <ItemGroup>
      <_DashboardPreviewAsset Include="$(IntermediateOutputPath)worker-poc/preview/**/*" Exclude="$(IntermediateOutputPath)worker-poc/preview/.vite/**/*" />
      <_DashboardPreviewAsset Update="@(_DashboardPreviewAsset)">
        <LogicalName>CodexServer.dashboard-preview/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))</LogicalName>
      </_DashboardPreviewAsset>
      <EmbeddedResource Include="@(_DashboardPreviewAsset)" />
    </ItemGroup>
  </Target>
  <!-- A no-build publish cannot prove that the assembly contains current frontend inputs. -->
  <Target Name="RequireCurrentDashboardPublish" BeforeTargets="BuildWorkerPoc;PrepareForPublish" Condition="'$(NoBuild)' == 'true'">
    <Error Text="Server publish requires a build to regenerate and verify embedded dashboard assets; omit --no-build." />
  </Target>
</Project>
